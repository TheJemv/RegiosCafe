# Copia este archivo a .env y llena los valores:  cp .env.example .env

# Token del túnel de Cloudflare.
# Cloudflare Zero Trust → Networks → Tunnels → (tu túnel) → Install connector:
# copia el valor largo que aparece después de --token
TUNNEL_TOKEN=

# Opcional: URL pública final del sitio, p. ej. https://cafeteriaregios.com
# Se usa para el canonical y las vistas previas al compartir (Open Graph).
# Si la cambias, reconstruye: docker compose up -d --build
SITE_URL=
