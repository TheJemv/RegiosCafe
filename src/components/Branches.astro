---
import { branches, formatPhone, formatTime, mapsHref, site, telHref } from '../data/site';
import Icon, { type IconName } from './Icon.astro';
---

<section class="section branches" id="sucursales" aria-labelledby="sucursales-title">
	<div class="container">
		<div class="section-head">
			<p class="eyebrow">Sucursales</p>
			<h2 id="sucursales-title">{branches.length} cocinas en Matamoros.</h2>
			<p>Del centro histórico a la Central de Camiones. Encuentra la que te queda más cerca y llama con un toque.</p>
		</div>

		<ul class="branches__grid">
			{
				branches.map((b) => (
					<li class="branch">
						<div class="branch__head">
							<div>
								<p class="branch__area">{b.area}</p>
								<h3>{b.name}</h3>
							</div>
							{b.hours && (
								<span class="branch__status" data-branch-status data-hours={JSON.stringify(b.hours)} hidden />
							)}
						</div>

						<p class="branch__blurb">{b.blurb}</p>

						<dl class="branch__info">
							<div>
								<dt>
									<Icon name="pin" size={18} />
									<span class="sr-only">Dirección</span>
								</dt>
								<dd>
									{b.street}, {b.neighborhood}
									<br />
									CP {b.postalCode}
								</dd>
							</div>
							<div>
								<dt>
									<Icon name="phone" size={18} />
									<span class="sr-only">Teléfono</span>
								</dt>
								<dd class="branch__phones">
									{b.phones.map((p) => (
										<a href={telHref(p)}>{formatPhone(p)}</a>
									))}
								</dd>
							</div>
							<div>
								<dt>
									<Icon name="clock" size={18} />
									<span class="sr-only">Horario</span>
								</dt>
								<dd>
									{b.hours ? (
										<>
											Lun a Sáb · {formatTime(b.hours.monSat[0])} – {formatTime(b.hours.monSat[1])}
											<br />
											Domingo · {formatTime(b.hours.sun[0])} – {formatTime(b.hours.sun[1])}
										</>
									) : (
										'Llama para consultar horario'
									)}
								</dd>
							</div>
						</dl>

						<div class="branch__actions">
							<a class="btn btn--sm" href={telHref(b.phones[0])}>
								<Icon name="phone" size={16} /> Llamar
							</a>
							<a class="btn btn--ghost btn--sm" href={mapsHref(b)} target="_blank" rel="noopener">
								<Icon name="directions" size={16} /> Cómo llegar
							</a>
						</div>
					</li>
				))
			}
		</ul>

		<div class="amenities">
			<p class="amenities__title">Para que estés a gusto</p>
			<ul>
				{
					site.amenities.map((a) => (
						<li>
							<span class="amenities__icon">
								<Icon name={a.icon as IconName} size={22} />
							</span>
							{a.label}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	import { getStatus } from '../scripts/hours';

	document.querySelectorAll<HTMLElement>('[data-branch-status]').forEach((el) => {
		const status = getStatus(JSON.parse(el.dataset.hours!));
		el.textContent = status.text;
		el.toggleAttribute('data-open', status.open);
		el.hidden = false;
	});
</script>

<style>
	.branches__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(16px, 2vw, 24px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.branch {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: clamp(20px, 3vw, 32px);
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.branch:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
	}

	.branch__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.branch__area {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--orange-ink);
	}

	.branch h3 {
		font-size: clamp(1.625rem, 3vw, 2rem);
	}

	.branch__status {
		flex: none;
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		background: var(--sand);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-2);
		white-space: nowrap;
	}

	.branch__status[hidden] {
		display: none;
	}

	.branch__status[data-open] {
		background: #e3f4ea;
		color: #17683a;
	}

	.branch__blurb {
		color: var(--ink-2);
	}

	.branch__info {
		display: grid;
		gap: 0.875rem;
		margin: 0;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--line);
	}

	.branch__info div {
		display: grid;
		grid-template-columns: 18px 1fr;
		gap: 0.75rem;
	}

	.branch__info dt {
		padding-top: 0.2rem;
		color: var(--orange-ink);
	}

	.branch__info dd {
		margin: 0;
		font-size: 0.9375rem;
	}

	.branch__phones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}

	.branch__phones a {
		font-weight: 600;
		text-decoration-color: var(--orange);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.branch__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
	}

	.amenities {
		display: grid;
		gap: 1.25rem;
		margin-top: clamp(32px, 5vw, 56px);
		padding: clamp(20px, 3vw, 32px);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
	}

	.amenities__title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
	}

	.amenities ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: 1rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.amenities li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.amenities__icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: var(--orange-soft);
		color: var(--orange-ink);
	}

	@media (max-width: 820px) {
		.branches__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 420px) {
		.branch__head {
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
