---
import { formatPrice, menu, moreCategories } from '../data/menu';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section menu" id="menu" aria-labelledby="menu-title">
	<div class="container">
		<div class="section-head">
			<p class="eyebrow">Nuestro menú</p>
			<h2 id="menu-title">Almuerzos norteños, como en casa.</h2>
			<p>Los favoritos de la casa con precio de mostrador. Pregunta en tu sucursal por el guisado del día.</p>
		</div>

		<div class="menu__layout">
			<div class="menu__board" data-tabs>
				<div class="menu__tabs" role="tablist" aria-label="Categorías del menú">
					{
						menu.map((cat, i) => (
							<button
								type="button"
								role="tab"
								id={`tab-${cat.id}`}
								aria-controls={`panel-${cat.id}`}
								aria-selected={i === 0 ? 'true' : 'false'}
								tabindex={i === 0 ? 0 : -1}
							>
								{cat.name}
								<span class="count">{cat.items.length}</span>
							</button>
						))
					}
				</div>

				{
					menu.map((cat) => (
						<div class="menu__panel" role="tabpanel" id={`panel-${cat.id}`} aria-labelledby={`tab-${cat.id}`} tabindex="0">
							<p class="menu__blurb">{cat.blurb}</p>
							<ul class="menu__list">
								{cat.items.map((item) => (
									<li class="dish">
										<div class="dish__row">
											<h3>
												{item.name}
												{item.tag && <span class="dish__tag">{item.tag}</span>}
											</h3>
											<span class="dish__leader" aria-hidden="true" />
											<span class:list={['dish__price', { 'is-pending': item.price === null }]}>
												{formatPrice(item.price)}
											</span>
										</div>
										<p>{item.description}</p>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>

			<aside class="menu__aside">
				<div class="spotlight">
					<p class="spotlight__kicker">La especialidad regional</p>
					<h3>El Guayin</h3>
					<p>
						Una tortilla de huevo que envuelve frijoles guisados, bañada en salsa ranchera. En su versión especial lleva queso,
						jamón, salchicha y tocino. Si es tu primera vez en Regio's, empieza por aquí.
					</p>
					<a class="btn btn--sm" href="#sucursales">Ven a probarlo <Icon name="arrow" size={16} /></a>
				</div>

				<div class="more">
					<h3>También en sucursal</h3>
					<ul>{moreCategories.map((c) => <li>{c}</li>)}</ul>
				</div>

				<div class="delivery">
					<p><Icon name="bike" size={20} /> ¿Prefieres en casa? Pide a domicilio:</p>
					<div class="delivery__links">
						{
							site.delivery.map((d) => (
								<a class="btn btn--ghost btn--sm" href={d.url} target="_blank" rel="noopener">
									{d.name}
								</a>
							))
						}
					</div>
				</div>
			</aside>
		</div>

		<p class="menu__note">Precios en pesos mexicanos (MXN). Pueden variar por sucursal y cambiar sin previo aviso.</p>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

		const select = (index: number, focus = false) => {
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
				panels[i].hidden = !active;
			});
			if (focus) tabs[index].focus();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i));
			tab.addEventListener('keydown', (e) => {
				const keys: Record<string, number> = {
					ArrowRight: (i + 1) % tabs.length,
					ArrowLeft: (i - 1 + tabs.length) % tabs.length,
					Home: 0,
					End: tabs.length - 1,
				};
				if (e.key in keys) {
					e.preventDefault();
					select(keys[e.key], true);
				}
			});
		});

		select(0);
	});
</script>

<style>
	.menu {
		background:
			radial-gradient(circle at 1px 1px, rgb(28 20 16 / 7%) 1px, transparent 0) 0 0 / 22px 22px,
			var(--sand);
	}

	.menu__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: clamp(24px, 3vw, 40px);
		align-items: start;
	}

	.menu__board {
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.menu__tabs {
		display: flex;
		gap: 0.25rem;
		padding: 0.5rem;
		overflow-x: auto;
		background: var(--night);
		scrollbar-width: none;
	}

	.menu__tabs::-webkit-scrollbar {
		display: none;
	}

	[role='tab'] {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		flex: none;
		min-height: 44px;
		padding: 0.625rem 1.125rem;
		border: 0;
		border-radius: 12px;
		background: transparent;
		color: rgb(251 246 238 / 72%);
		font: 600 0.9375rem/1 var(--font-body);
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	[role='tab']:hover {
		color: var(--cream);
		background: rgb(255 255 255 / 6%);
	}

	[role='tab'][aria-selected='true'] {
		background: var(--orange);
		color: var(--ink);
	}

	.count {
		display: inline-grid;
		place-items: center;
		min-width: 22px;
		height: 22px;
		padding-inline: 6px;
		border-radius: 999px;
		background: rgb(255 255 255 / 12%);
		font-size: 0.75rem;
	}

	[aria-selected='true'] .count {
		background: rgb(28 20 16 / 14%);
	}

	.menu__panel {
		padding: clamp(20px, 3.5vw, 40px);
	}

	.menu__panel:focus-visible {
		outline-offset: -6px;
	}

	.menu__blurb {
		margin-bottom: 1.5rem;
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-style: italic;
		color: var(--ink-2);
	}

	.menu__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.75rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dish {
		display: grid;
		gap: 0.375rem;
	}

	.dish__row {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.dish h3 {
		font-size: 1.1875rem;
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: -0.005em;
	}

	.dish__tag {
		display: inline-block;
		margin-left: 0.375rem;
		padding: 0.1875rem 0.5rem;
		border-radius: 999px;
		background: var(--orange-soft);
		color: var(--orange-ink);
		font: 700 0.6875rem/1.2 var(--font-body);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		vertical-align: 0.2em;
	}

	.dish__leader {
		flex: 1;
		min-width: 1.5rem;
		border-bottom: 2px dotted var(--line);
		transform: translateY(-0.3em);
	}

	.dish__price {
		font-family: var(--font-display);
		font-size: 1.1875rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.dish__price.is-pending {
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink-3);
	}

	.dish p {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-2);
	}

	.menu__aside {
		display: grid;
		gap: 1rem;
	}

	.spotlight {
		position: relative;
		display: grid;
		gap: 0.75rem;
		justify-items: start;
		padding: 1.75rem;
		border-radius: var(--radius-lg);
		background: var(--night);
		color: var(--cream);
		overflow: hidden;
	}

	.spotlight::before {
		content: '';
		position: absolute;
		right: -70px;
		top: -90px;
		width: 170px;
		height: 170px;
		border-radius: 50%;
		background: var(--orange);
		opacity: 0.9;
	}

	.spotlight > * {
		position: relative;
	}

	.spotlight__kicker {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #ffb27a;
	}

	.spotlight h3 {
		font-size: 2.25rem;
		font-style: italic;
	}

	.spotlight p:not(.spotlight__kicker) {
		font-size: 0.9375rem;
		color: rgb(251 246 238 / 80%);
	}

	.more,
	.delivery {
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--paper);
	}

	.more h3 {
		margin-bottom: 0.875rem;
		font-size: 1.125rem;
	}

	.more ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.more li {
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		background: var(--sand);
		font-size: 0.875rem;
		font-weight: 500;
	}

	.delivery p {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.875rem;
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.delivery p :global(svg) {
		color: var(--orange-ink);
		flex: none;
	}

	.delivery__links {
		display: flex;
		gap: 0.5rem;
	}

	.menu__note {
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		color: var(--ink-3);
	}

	@media (max-width: 1024px) {
		.menu__layout {
			grid-template-columns: 1fr;
		}

		.menu__aside {
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		}
	}

	@media (max-width: 480px) {
		[role='tab'] {
			padding-inline: 0.875rem;
		}

		.count {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.menu__list {
			grid-template-columns: 1fr;
		}

		.dish h3 {
			font-size: 1.0625rem;
		}
	}
</style>
