---
import { site } from '../data/site';
import Icon from './Icon.astro';

const years = new Date().getFullYear() - site.since;
---

<section class="section about" id="nosotros" aria-labelledby="nosotros-title">
	<div class="container about__grid">
		<div class="about__badge" aria-hidden="true">
			<span class="badge__small">Desde</span>
			<span class="badge__year">{site.since}</span>
			<span class="badge__small">Matamoros, Tamps.</span>
		</div>

		<div class="about__copy">
			<p class="eyebrow">Nosotros</p>
			<h2 id="nosotros-title">{years} años siendo el punto de reunión de Matamoros.</h2>
			<p>
				Desde {site.since} servimos almuerzos norteños, café caliente y antojitos hechos al momento. Aquí se juntan las familias
				el domingo, los compañeros de oficina entre semana y los viajeros que van de paso.
			</p>
			<p>Sin pretensiones: buena sazón, buen trato y la mesa siempre lista.</p>
			<blockquote>{site.slogan}</blockquote>
		</div>
	</div>

	<div class="container">
		<ul class="proof">
			<li>
				<strong>+{site.stats.checkins}</strong>
				<span>visitas registradas en Facebook</span>
			</li>
			<li>
				<strong>+{site.stats.followers}</strong>
				<span>seguidores en nuestra página</span>
			</li>
			<li>
				<strong>
					{site.stats.didiRating}
					<Icon name="star" size={22} class="star" />
				</strong>
				<span>de calificación en DiDi Food</span>
			</li>
		</ul>
	</div>
</section>

<style>
	.about__grid {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: center;
	}

	.about__badge {
		display: grid;
		place-items: center;
		align-content: center;
		width: clamp(200px, 26vw, 300px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--orange);
		color: var(--ink);
		box-shadow:
			inset 0 0 0 10px var(--orange),
			inset 0 0 0 12px var(--ink),
			var(--shadow-lg);
		transform: rotate(-8deg);
	}

	.badge__small {
		font-size: clamp(0.75rem, 1.2vw, 0.875rem);
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.badge__year {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 7vw, 5.5rem);
		font-style: italic;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.about__copy {
		display: grid;
		gap: 1.125rem;
		max-width: 640px;
	}

	.about__copy h2 {
		font-size: clamp(2rem, 4.6vw, 3.25rem);
	}

	.about__copy p:not(.eyebrow) {
		font-size: 1.0625rem;
		color: var(--ink-2);
	}

	blockquote {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
		border-left: 4px solid var(--orange);
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.2vw, 1.5rem);
		font-style: italic;
		font-weight: 500;
		line-height: 1.3;
	}

	.proof {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: clamp(48px, 7vw, 88px) 0 0;
		padding: 0;
		list-style: none;
		border-block: 1px solid var(--line);
	}

	.proof li {
		display: grid;
		gap: 0.25rem;
		padding: 1.75rem clamp(16px, 3vw, 32px);
	}

	.proof li + li {
		border-left: 1px solid var(--line);
	}

	.proof strong {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		line-height: 1.1;
	}

	.proof :global(.star) {
		color: var(--mustard);
		fill: var(--mustard);
	}

	.proof span {
		color: var(--ink-2);
	}

	@media (max-width: 760px) {
		.about__grid {
			grid-template-columns: 1fr;
			justify-items: start;
		}

		.proof {
			grid-template-columns: 1fr;
		}

		.proof li + li {
			border-left: 0;
			border-top: 1px solid var(--line);
		}
	}
</style>
